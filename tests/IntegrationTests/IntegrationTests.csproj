<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Services/Identity.Api/Identity.Api.csproj" />
    <ProjectReference Include="../../src/Services/Document.Api/Document.Api.csproj">
      <Aliases>DocumentApi</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/Services/Approval.Api/Approval.Api.csproj">
      <Aliases>ApprovalApi</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/Services/Notification.Api/Notification.Api.csproj">
      <Aliases>NotificationApi</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../src/BuildingBlocks/IntegrationContracts/IntegrationContracts.csproj" />
  </ItemGroup>

</Project>
