@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@using Client.Web.Contracts
@inject ApiClient Api

<PageTitle>Quản lý người dùng · DocFlow</PageTitle>

<div class="page-heading"><div><p class="eyebrow">QUẢN TRỊ</p><h1>Người dùng</h1><p class="muted">Quản lý tài khoản và một trong ba vai trò hệ thống.</p></div></div>

@if (!string.IsNullOrEmpty(message)) { <div class="alert @(isError ? "alert-error" : "alert-success")">@message</div> }
<section class="detail-grid admin-grid">
    <section class="form-card">
        <p class="eyebrow">TẠO TÀI KHOẢN</p><h2>Người dùng mới</h2>
        <div class="field"><label>Tên đăng nhập</label><input maxlength="64" @bind="username" /></div>
        <div class="field"><label>Họ tên</label><input maxlength="160" @bind="fullName" /></div>
        <div class="field"><label>Email</label><input type="email" maxlength="254" @bind="email" /></div>
        <div class="field"><label>Mật khẩu tạm thời</label><input type="password" minlength="12" @bind="password" /><small>Tối thiểu 12 ký tự.</small></div>
        <div class="field"><label>Vai trò</label><select @bind="role"><option>Creator</option><option>Approver</option><option>Admin</option></select></div>
        <button class="button button-primary" disabled="@saving" @onclick="CreateAsync">@(saving ? "Đang tạo…" : "Tạo tài khoản")</button>
    </section>
    <section class="section-card users-table-card">
        <div class="section-heading"><div><p class="eyebrow">DANH SÁCH</p><h2>@users.Count tài khoản</h2></div><button class="button button-secondary" @onclick="LoadAsync">Làm mới</button></div>
        @if (loading)
        {
            <div class="loading-card">Đang tải người dùng…</div>
        }
        else
        {
            <div class="table-wrap"><table><thead><tr><th>Tài khoản</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr></thead><tbody>
                @foreach (var user in users)
                {
                    <tr><td><strong>@user.FullName</strong><small class="table-subtitle">@user.Username · @user.Email</small></td>
                        <td><select aria-label="Vai trò của @user.Username" value="@user.Role" disabled="@updating.Contains(user.Id)" @onchange="args => ChangeRoleAsync(user, args)"><option>Admin</option><option>Creator</option><option>Approver</option></select></td>
                        <td><span class="status-pill @(user.IsActive ? "status-approved" : "status-rejected")">@(user.IsActive ? "Đang hoạt động" : "Đã tắt")</span></td>
                        <td><button class="button button-secondary" disabled="@updating.Contains(user.Id)" @onclick="() => ChangeStatusAsync(user)">@(user.IsActive ? "Vô hiệu hóa" : "Kích hoạt")</button></td></tr>
                }
            </tbody></table></div>
        }
    </section>
</section>

@code {
    private List<UserResponse> users = [];
    private readonly HashSet<Guid> updating = [];
    private string username = string.Empty;
    private string fullName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string role = "Creator";
    private string? message;
    private bool isError;
    private bool loading = true;
    private bool saving;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try { users = await Api.GetAsync<List<UserResponse>>("identity", "api/users") ?? []; }
        catch { message = "Không tải được danh sách người dùng."; isError = true; }
        finally { loading = false; }
    }

    private async Task CreateAsync()
    {
        saving = true;
        try
        {
            using var response = await Api.SendJsonAsync("identity", HttpMethod.Post, "api/users",
                new CreateUserRequest(username, fullName, email, password, role));
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict) throw new InvalidOperationException("Tên đăng nhập hoặc email đã được dùng.");
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException("Không tạo được tài khoản. Kiểm tra thông tin và mật khẩu.");
            message = $"Đã tạo tài khoản {username}.";
            isError = false;
            username = fullName = email = password = string.Empty;
            await LoadAsync();
        }
        catch (Exception exception) { message = exception.Message; isError = true; }
        finally { saving = false; }
    }

    private async Task ChangeStatusAsync(UserResponse user)
    {
        updating.Add(user.Id);
        try
        {
            using var response = await Api.SendJsonAsync("identity", HttpMethod.Patch,
                $"api/users/{user.Id}/status", new ChangeUserStatusRequest(!user.IsActive));
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException("Không thể thay đổi trạng thái tài khoản.");
            await LoadAsync();
        }
        catch (Exception exception) { message = exception.Message; isError = true; }
        finally { updating.Remove(user.Id); }
    }

    private async Task ChangeRoleAsync(UserResponse user, ChangeEventArgs args)
    {
        var nextRole = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(nextRole) || nextRole == user.Role) return;
        updating.Add(user.Id);
        try
        {
            using var response = await Api.SendJsonAsync("identity", HttpMethod.Patch,
                $"api/users/{user.Id}/role", new ChangeUserRoleRequest(nextRole));
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException("Không thể thay đổi vai trò tài khoản.");
            await LoadAsync();
        }
        catch (Exception exception) { message = exception.Message; isError = true; await LoadAsync(); }
        finally { updating.Remove(user.Id); }
    }
}
