{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "DistributedDocApproval.Identity",
    "Audience": "DistributedDocApproval.Client"
  },
  "RabbitMq": {
    "QueueName": "notification.events",
    "RoutingKeys": [
      "approval.task-assigned.v1",
      "document.approved.v1",
      "document.rejected.v1"
    ]
  },
  "AllowedHosts": "*"
}
